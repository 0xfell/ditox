    "statusLineTone": {
      "enum": ["auto", "fg", "border", "muted", "secondary", "accent", "success", "warning", "error", "search", "favorite", "image"]
    },
    "previewImageField": {
      "enum": ["type", "mime", "size", "dimensions", "hash", "blob"]
    },
    "imagePreviewNoticeVisibility": {
      "enum": ["never", "protocol", "always"]
    },
    "imagePreviewRenderer": {
      "enum": ["auto", "native", "opentui", "text"]
    },
    "imagePreviewAlign": {
      "enum": ["left", "center", "right"]
    },
    "overlayPlacement": {
      "enum": ["bottom", "top"]
    },
    "scrollbarPlacement": {
      "enum": ["left", "right"]
    },
    "borderStyle": {
      "enum": ["single", "double", "rounded", "heavy"]
    },
    "titleAlignment": {
      "enum": ["left", "center", "right"]
    },
    "verticalAlignment": {
      "enum": ["top", "center", "bottom"]
    },
    "color": {
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{6}|[A-Za-z]+)$"
    },
    "keyBindingValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "surfaceStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bg": { "$ref": "#/$defs/color" },
        "fg": { "$ref": "#/$defs/color" },
        "border": { "$ref": "#/$defs/color" },
        "accent": { "$ref": "#/$defs/color" },
        "muted": { "$ref": "#/$defs/color" },
        "secondary": { "$ref": "#/$defs/color" },
        "success": { "$ref": "#/$defs/color" },
        "warning": { "$ref": "#/$defs/color" },
        "error": { "$ref": "#/$defs/color" },
        "search": { "$ref": "#/$defs/color" },
        "favorite": { "$ref": "#/$defs/color" },
        "image": { "$ref": "#/$defs/color" },
        "bold": { "type": "boolean" },
        "dim": { "type": "boolean" },
        "italic": { "type": "boolean" },
        "underline": { "type": "boolean" },
        "blink": { "type": "boolean" },
        "inverse": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "strikethrough": { "type": "boolean" }
