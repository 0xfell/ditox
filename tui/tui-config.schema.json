  "$defs": {
    "themeName": {
      "enum": ["ditoxDark", "ditoxLight", "groknight", "grokday", "tokyonight", "rosepine"]
    },
    "terminalAltScreen": {
      "enum": ["auto", "always", "never"]
    },
    "terminalScreenMode": {
      "enum": ["alternate-screen", "main-screen", "split-footer"]
    },
    "terminalCursorStyle": {
      "enum": ["default", "block", "line", "underline"]
    },
    "kittyKeyboard": {
      "oneOf": [
        { "type": "boolean" },
        { "enum": ["off", "on", "basic", "events", "all", "disabled", "enabled", "none"] },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "disambiguate": { "type": "boolean" },
            "alternateKeys": { "type": "boolean" },
            "events": { "type": "boolean" },
            "allKeysAsEscapes": { "type": "boolean" },
            "reportText": { "type": "boolean" }
          }
        }
      ]
    },
    "entryFilter": {
      "enum": ["all", "text", "images", "favorites", "today"]
    },
    "helpAction": {
      "enum": [
        "moveSelection",
        "pageSelection",
        "firstLastEntry",
        "quit",
        "preview",
        "previewNavigation",
        "previewBack",
        "pinnedView",
        "paste",
        "copySet",
