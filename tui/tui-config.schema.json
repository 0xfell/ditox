{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ditox.local/tui-config.schema.json",
  "title": "Ditox TUI config",
  "description": "File-backed OpenTUI customization for Ditox. The TUI reads this file from DITOX_TUI_CONFIG or ~/.config/ditox/tui.json.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "theme": {
      "oneOf": [
        {
          "$ref": "#/$defs/themeName"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preset": {
              "$ref": "#/$defs/themeName"
            },
            "colors": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "bgBase": { "$ref": "#/$defs/color" },
                "bgPanel": { "$ref": "#/$defs/color" },
                "bgElevated": { "$ref": "#/$defs/color" },
                "bgSelected": { "$ref": "#/$defs/color" },
                "bgSubtle": { "$ref": "#/$defs/color" },
                "border": { "$ref": "#/$defs/color" },
                "borderFocused": { "$ref": "#/$defs/color" },
                "textPrimary": { "$ref": "#/$defs/color" },
                "textSecondary": { "$ref": "#/$defs/color" },
                "textMuted": { "$ref": "#/$defs/color" },
                "textDim": { "$ref": "#/$defs/color" },
                "selectionFg": { "$ref": "#/$defs/color" },
                "accentText": { "$ref": "#/$defs/color" },
                "accentImage": { "$ref": "#/$defs/color" },
                "accentFavorite": { "$ref": "#/$defs/color" },
                "accentError": { "$ref": "#/$defs/color" },
                "accentSuccess": { "$ref": "#/$defs/color" },
                "accentWarning": { "$ref": "#/$defs/color" },
                "accentSearch": { "$ref": "#/$defs/color" },
                "accentCommand": { "$ref": "#/$defs/color" },
                "scrollbarTrack": { "$ref": "#/$defs/color" },
                "scrollbarThumb": { "$ref": "#/$defs/color" }
              }
            }
          }
        }
      ]
    },
    "themeFile": {
      "type": "string",
      "description": "Optional external custom_theme.json color file. Relative paths resolve next to this config file."
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "description": "Terminal renderer behavior. `alt_screen` is accepted as a Grok-style alias for `altScreen`.",
      "properties": {
        "altScreen": { "$ref": "#/$defs/terminalAltScreen" },
        "alt_screen": { "$ref": "#/$defs/terminalAltScreen" },
        "screenMode": { "$ref": "#/$defs/terminalScreenMode" },
        "title": {
          "type": ["string", "null"],
          "description": "Optional terminal window title set by OpenTUI. Null or omission leaves the existing terminal title alone."
        },
        "footerHeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 48,
          "description": "Reserved footer rows when `screenMode` is `split-footer`."
        },
        "clearOnShutdown": {
          "type": "boolean",
          "description": "Whether OpenTUI clears its terminal surface during renderer shutdown."
        },
        "backgroundColor": {
          "description": "`auto` uses the configured shell surface background, `transparent` preserves the terminal background, and hex values set an explicit renderer background.",
          "oneOf": [
            { "enum": ["auto", "transparent"] },
            { "$ref": "#/$defs/color" }
          ]
        },
        "cursor": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional terminal cursor presentation. Null values leave the terminal/default OpenTUI behavior alone.",
          "properties": {
            "style": {
              "oneOf": [
                { "$ref": "#/$defs/terminalCursorStyle" },
                { "enum": ["auto", "none", null] }
              ]
            },
            "blinking": {
              "oneOf": [
                { "type": "boolean" },
                { "enum": ["auto", "none", null] }
              ]
            },
            "color": {
              "oneOf": [
                { "$ref": "#/$defs/color" },
                { "enum": ["auto", "none", null] }
              ]
            }
          }
        },
        "kittyKeyboard": {
          "$ref": "#/$defs/kittyKeyboard",
          "description": "Opt into the Kitty keyboard protocol. This improves key disambiguation in terminals that support it; it is separate from Kitty graphics."
        },
        "targetFps": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 240,
          "description": "Optional OpenTUI target FPS override. Null or omission leaves the renderer default."
        },
        "maxFps": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 240,
          "description": "Optional OpenTUI max FPS override. Null or omission leaves the renderer default."
        },
        "debounceDelay": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 250,
          "description": "Optional OpenTUI render debounce in milliseconds. Null or omission leaves the renderer default."
        },
        "stdinParserMaxBufferBytes": {
          "type": ["integer", "null"],
          "minimum": 4096,
          "maximum": 16777216,
          "description": "Optional OpenTUI stdin parser buffer limit for large paste/input sequences."
        }
      }
    },
    "filterOrder": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entryFilter"
      },
      "uniqueItems": true
    },
    "helpOrder": {
      "type": "array",
      "description": "Ordered subset of help rows shown in the help overlay. Omit rows to hide them.",
      "items": {
        "$ref": "#/$defs/helpAction"
      },
      "uniqueItems": true
    },
    "startup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filter": { "$ref": "#/$defs/entryFilter" },
        "pinnedOnly": { "type": "boolean" },
        "query": { "type": "string" }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "liveSearch": { "type": "boolean" },
        "liveSearchDebounceMs": { "type": "integer", "minimum": 0 },
        "clearQueryOnSearchOpen": { "type": "boolean" },
        "restoreQueryOnSearchCancel": { "type": "boolean" },
        "exitAfterPaste": { "type": "boolean" },
        "exitAfterCopy": { "type": "boolean" },
        "exitAfterBulkCopy": { "type": "boolean" },
        "exitAfterSearchCopy": { "type": "boolean" }
      }
    },
    "maxEntryLength": {
      "type": "integer",
      "minimum": 0,
      "description": "Compatibility alias: row preview character cap."
    },
    "pollInterval": {
      "type": "integer",
      "minimum": 0,
      "description": "Compatibility alias: TUI refresh interval in milliseconds."
    },
    "enableMouse": {
      "type": "boolean",
      "description": "Compatibility alias: mouse enablement."
    },
    "enableDescription": {
      "type": "boolean",
      "description": "Compatibility alias: metadata visibility."
    },
    "imageDisplay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["basic", "kitty", "sixel"],
          "description": "Compatibility alias: image mode. Kitty and Sixel currently fall back to block previews."
        },
        "scaleX": { "type": "number", "exclusiveMinimum": 0 },
        "scaleY": { "type": "number", "exclusiveMinimum": 0 },
        "heightCut": { "type": "number", "minimum": 0 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compactMode": { "type": "boolean" },
        "listWidthPercent": { "type": "number" },
        "previewWidthPercent": { "type": "number" },
        "maxPreviewLines": { "type": "integer" },
        "maxFullPreviewLines": { "type": "integer" },
        "historyLimit": { "type": "integer" },
        "imagePreviewMode": { "enum": ["metadata", "blocks", "kitty", "sixel"] },
        "fullPreviewImageMode": { "enum": ["metadata", "blocks", "kitty", "sixel"] },
        "imagePreviewMaxWidth": { "type": "integer" },
        "imagePreviewMaxRows": { "type": "integer" },
        "fullPreviewImageMaxWidth": { "type": "integer" },
        "fullPreviewImageMaxRows": { "type": "integer" },
        "imagePreviewRenderer": { "$ref": "#/$defs/imagePreviewRenderer" },
        "fullPreviewImageRenderer": { "$ref": "#/$defs/imagePreviewRenderer" },
        "imagePreviewAlign": { "$ref": "#/$defs/imagePreviewAlign" },
        "fullPreviewImageAlign": { "$ref": "#/$defs/imagePreviewAlign" },
        "imagePreviewBlockGlyph": { "type": "string" },
        "fullPreviewImageBlockGlyph": { "type": "string" },
        "imagePreviewBackground": {
          "type": "string",
          "pattern": "^(auto|#[0-9a-fA-F]{6})$",
          "description": "`auto` uses the active preview surface background; a hex color blends transparent image pixels against that color."
        },
        "fullPreviewImageBackground": {
          "type": "string",
          "pattern": "^(auto|#[0-9a-fA-F]{6})$",
          "description": "`auto` uses the active full-preview surface background; a hex color blends transparent image pixels against that color."
        },
        "imagePreviewNoticeVisibility": { "$ref": "#/$defs/imagePreviewNoticeVisibility" },
        "fullPreviewImageNoticeVisibility": { "$ref": "#/$defs/imagePreviewNoticeVisibility" },
        "imagePreviewNoticeSpacing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Blank rows between a rendered split image block preview and its source/protocol notice."
        },
        "fullPreviewImageNoticeSpacing": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Blank rows between a rendered full-preview image block preview and its source/protocol notice."
        },
        "headerHeight": { "type": "integer" },
        "statusHeight": { "type": "integer" },
        "showHeader": { "type": "boolean" },
        "showStatusLine": { "type": "boolean" },
        "searchOverlayHeight": { "type": "integer" },
        "confirmOverlayHeight": { "type": "integer" },
        "confirmPinnedExtraRows": { "type": "integer" },
        "clearOverlayHeight": { "type": "integer" },
        "helpOverlayHeight": { "type": "integer" },
        "overlayPlacement": { "$ref": "#/$defs/overlayPlacement" },
        "minPaneWidth": { "type": "integer" },
        "splitPaneGap": { "type": "integer" },
        "splitPaneWidthInset": { "type": "integer" },
        "fullPreviewWidthInset": { "type": "integer" },
        "previewTextWidthInset": { "type": "integer" },
        "fullPreviewTextWidthInset": { "type": "integer" },
        "previewContentAlign": { "$ref": "#/$defs/titleAlignment" },
        "fullPreviewContentAlign": { "$ref": "#/$defs/titleAlignment" },
        "previewBodyVerticalAlign": { "$ref": "#/$defs/verticalAlignment" },
        "fullPreviewBodyVerticalAlign": { "$ref": "#/$defs/verticalAlignment" },
        "imagePreviewRowInset": { "type": "integer" },
        "fullPreviewImageRowInset": { "type": "integer" },
        "fullPreviewScrollInsetRows": { "type": "integer" },
        "previewLineNumberWidth": { "type": "integer" },
        "previewGutterWidth": { "type": "integer" },
        "fullPreviewGutterWidth": { "type": "integer" },
        "previewGutterAlign": { "$ref": "#/$defs/titleAlignment" },
        "fullPreviewGutterAlign": { "$ref": "#/$defs/titleAlignment" },
        "previewLineSpacing": { "type": "integer" },
        "fullPreviewLineSpacing": { "type": "integer" },
        "previewMetaHeight": { "type": "integer" },
        "fullPreviewMetaHeight": { "type": "integer" },
        "previewMetaLineSpacing": { "type": "integer" },
        "fullPreviewMetaLineSpacing": { "type": "integer" },
        "previewMetaHashLength": { "type": "integer" },
        "fullPreviewMetaHashLength": { "type": "integer" },
        "previewImageFields": {
          "type": "array",
          "items": { "$ref": "#/$defs/previewImageField" },
          "uniqueItems": true
        },
        "headerBrandMaxWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Maximum header brand segment width. Set to 0 for automatic fitting only."
        },
        "headerFilterMaxWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Maximum header filter segment width. Set to 0 for automatic fitting only."
        },
        "headerQueryMaxWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Maximum header query segment width. Set to 0 for automatic fitting only."
        },
        "headerModeMaxWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Maximum header mode/selection segment width. Set to 0 for automatic fitting only."
        },
        "statusSeparatorPadding": { "type": "integer" },
        "statusSeparatorPaddingLeft": { "type": "integer" },
        "statusSeparatorPaddingRight": { "type": "integer" },
        "statusOperationMaxWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Maximum status-line operation segment width. Set to 0 for automatic fitting only."
        },
        "statusWatcherMaxWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Maximum status-line watcher segment width. Set to 0 for automatic fitting only."
        },
        "statusHintMaxWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Maximum status-line key-hint segment width. Set to 0 for automatic fitting only."
        },
        "searchOverlayPromptMaxWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Maximum search-overlay prompt segment width. Set to 0 for automatic fitting only."
        },
        "searchOverlayQueryMaxWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Maximum search-overlay query segment width. Set to 0 for automatic fitting only."
        },
        "searchOverlayCursorMaxWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Maximum search-overlay cursor segment width. Set to 0 for automatic fitting only."
        },
        "dangerOverlayPromptMaxWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Maximum delete/clear prompt width in danger overlays. Set to 0 for automatic fitting only."
        },
        "dangerOverlayHintMaxWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Maximum warning and confirmation-hint width in danger overlays. Set to 0 for automatic fitting only."
        },
        "helpOverlayActionMaxWidth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 200,
          "description": "Maximum help-overlay action text width. Set to 0 for automatic fitting only."
        },
        "frameTitlePadding": { "type": "integer" },
        "frameTitlePaddingLeft": { "type": "integer" },
        "frameTitlePaddingRight": { "type": "integer" },
        "shellPaddingX": { "type": "integer" },
        "shellPaddingY": { "type": "integer" },
        "headerPaddingX": { "type": "integer" },
        "headerPaddingY": { "type": "integer" },
        "statusPaddingX": { "type": "integer" },
        "statusPaddingY": { "type": "integer" },
        "headerContentAlign": { "$ref": "#/$defs/titleAlignment" },
        "statusContentAlign": { "$ref": "#/$defs/titleAlignment" },
        "headerVerticalAlign": { "$ref": "#/$defs/verticalAlignment" },
        "statusVerticalAlign": { "$ref": "#/$defs/verticalAlignment" },
        "overlayPaddingX": { "type": "integer" },
        "overlayPaddingY": { "type": "integer" },
        "overlayContentAlign": { "$ref": "#/$defs/titleAlignment" },
        "overlayVerticalAlign": { "$ref": "#/$defs/verticalAlignment" },
        "overlayLineSpacing": { "type": "integer" },
        "searchOverlayPaddingX": { "type": "integer" },
        "searchOverlayPaddingY": { "type": "integer" },
        "searchOverlayContentAlign": { "$ref": "#/$defs/titleAlignment" },
        "searchOverlayVerticalAlign": { "$ref": "#/$defs/verticalAlignment" },
        "searchOverlayLineSpacing": { "type": "integer" },
        "dangerOverlayPaddingX": { "type": "integer" },
        "dangerOverlayPaddingY": { "type": "integer" },
        "dangerOverlayContentAlign": { "$ref": "#/$defs/titleAlignment" },
        "dangerOverlayVerticalAlign": { "$ref": "#/$defs/verticalAlignment" },
        "dangerOverlayLineSpacing": { "type": "integer" },
        "helpOverlayPaddingX": { "type": "integer" },
        "helpOverlayPaddingY": { "type": "integer" },
        "helpOverlayContentAlign": { "$ref": "#/$defs/titleAlignment" },
        "helpOverlayVerticalAlign": { "$ref": "#/$defs/verticalAlignment" },
        "helpOverlayLineSpacing": { "type": "integer" },
        "listPaddingX": { "type": "integer" },
        "listPaddingY": { "type": "integer" },
        "previewPaddingX": { "type": "integer" },
        "previewPaddingY": { "type": "integer" },
        "fullPreviewPaddingX": { "type": "integer" },
        "fullPreviewPaddingY": { "type": "integer" },
        "previewMetaPaddingX": { "type": "integer" },
        "previewMetaPaddingY": { "type": "integer" },
        "fullPreviewMetaPaddingX": { "type": "integer" },
        "fullPreviewMetaPaddingY": { "type": "integer" },
        "previewMetaContentAlign": { "$ref": "#/$defs/titleAlignment" },
        "fullPreviewMetaContentAlign": { "$ref": "#/$defs/titleAlignment" },
        "previewMetaVerticalAlign": { "$ref": "#/$defs/verticalAlignment" },
        "fullPreviewMetaVerticalAlign": { "$ref": "#/$defs/verticalAlignment" },
        "emptyStatePaddingX": { "type": "integer" },
        "emptyStatePaddingY": { "type": "integer" },
        "emptyStateContentAlign": { "$ref": "#/$defs/titleAlignment" },
        "emptyStateTitleAlign": { "$ref": "#/$defs/titleAlignment" },
        "emptyStateHelpAlign": { "$ref": "#/$defs/titleAlignment" },
        "emptyStateVerticalAlign": { "$ref": "#/$defs/verticalAlignment" },
        "emptyStateLineSpacing": { "type": "integer" },
        "helpKeyWidth": { "type": "integer" },
        "helpKeyAlign": { "$ref": "#/$defs/titleAlignment" },
        "confirmHintIndent": { "type": "integer" },
        "rowContentAlign": { "$ref": "#/$defs/titleAlignment" },
        "rowMetadataAlign": { "$ref": "#/$defs/titleAlignment" },
        "rowPreviewAlign": { "$ref": "#/$defs/titleAlignment" },
        "rowAgeWidth": { "type": "integer" },
        "rowAgeAlign": { "$ref": "#/$defs/titleAlignment" },
        "rowSizeWidth": { "type": "integer" },
        "rowSizeAlign": { "$ref": "#/$defs/titleAlignment" },
        "rowPinnedWidth": { "type": "integer" },
        "rowPinnedAlign": { "$ref": "#/$defs/titleAlignment" },
        "rowMetaHashLength": { "type": "integer" },
        "rowMarkerWidth": { "type": "integer" },
        "rowMarkerAlign": { "$ref": "#/$defs/titleAlignment" },
        "rowMarkerGap": { "type": "integer" },
        "rowMetaPreviewGap": { "type": "integer" },
        "rowPreviewReservedWidth": { "type": "integer" },
        "rowPreviewMaxWidth": { "type": "integer" },
        "rowSpacing": { "type": "integer" },
        "alternateRows": { "type": "boolean" },
        "refreshIntervalMs": { "type": "integer" },
        "mouseEnabled": { "type": "boolean" },
        "mouseScrollRows": { "type": "integer" },
        "showScrollbar": { "type": "boolean" },
        "scrollbarWidth": { "type": "integer" },
        "scrollbarPlacement": { "$ref": "#/$defs/scrollbarPlacement" },
        "scrollbarAlign": { "$ref": "#/$defs/titleAlignment" },
        "showMetadata": { "type": "boolean" },
        "showRowMetadata": { "type": "boolean" },
        "showPreviewPane": { "type": "boolean" },
        "showFullPreviewMetadata": { "type": "boolean" },
        "showPreviewGutter": { "type": "boolean" },
        "showFullPreviewGutter": { "type": "boolean" },
        "highlightSearchMatches": { "type": "boolean" },
        "showEmptyStateHelp": { "type": "boolean" },
        "panelPaddingX": { "type": "integer" },
        "panelPaddingY": { "type": "integer" }
      }
    },
    "chrome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "panelBorder": { "type": "boolean" },
        "overlayBorder": { "type": "boolean" },
        "headerBorder": { "type": "boolean" },
        "listBorder": { "type": "boolean" },
        "previewBorder": { "type": "boolean" },
        "fullPreviewBorder": { "type": "boolean" },
        "statusBorder": { "type": "boolean" },
        "searchOverlayBorder": { "type": "boolean" },
        "dangerOverlayBorder": { "type": "boolean" },
        "helpOverlayBorder": { "type": "boolean" },
        "showPanelTitles": { "type": "boolean" },
        "showOverlayTitles": { "type": "boolean" },
        "showHeaderTitle": { "type": "boolean" },
        "showListTitle": { "type": "boolean" },
        "showPreviewTitle": { "type": "boolean" },
        "showFullPreviewTitle": { "type": "boolean" },
        "showStatusTitle": { "type": "boolean" },
        "showSearchOverlayTitle": { "type": "boolean" },
        "showDangerOverlayTitle": { "type": "boolean" },
        "showHelpOverlayTitle": { "type": "boolean" },
        "showListPositionTitle": { "type": "boolean" },
        "showPreviewEntryTitle": { "type": "boolean" },
        "showFullPreviewBottomTitle": { "type": "boolean" },
        "panelBorderStyle": { "$ref": "#/$defs/borderStyle" },
        "overlayBorderStyle": { "$ref": "#/$defs/borderStyle" },
        "headerBorderStyle": { "$ref": "#/$defs/borderStyle" },
        "listBorderStyle": { "$ref": "#/$defs/borderStyle" },
        "previewBorderStyle": { "$ref": "#/$defs/borderStyle" },
        "fullPreviewBorderStyle": { "$ref": "#/$defs/borderStyle" },
        "statusBorderStyle": { "$ref": "#/$defs/borderStyle" },
        "searchOverlayBorderStyle": { "$ref": "#/$defs/borderStyle" },
        "dangerOverlayBorderStyle": { "$ref": "#/$defs/borderStyle" },
        "helpOverlayBorderStyle": { "$ref": "#/$defs/borderStyle" },
        "panelTitleAlignment": { "$ref": "#/$defs/titleAlignment" },
        "panelBottomTitleAlignment": { "$ref": "#/$defs/titleAlignment" },
        "overlayTitleAlignment": { "$ref": "#/$defs/titleAlignment" },
        "headerTitleAlignment": { "$ref": "#/$defs/titleAlignment" },
        "listTitleAlignment": { "$ref": "#/$defs/titleAlignment" },
        "previewTitleAlignment": { "$ref": "#/$defs/titleAlignment" },
        "fullPreviewTitleAlignment": { "$ref": "#/$defs/titleAlignment" },
        "statusTitleAlignment": { "$ref": "#/$defs/titleAlignment" },
        "listBottomTitleAlignment": { "$ref": "#/$defs/titleAlignment" },
        "previewBottomTitleAlignment": { "$ref": "#/$defs/titleAlignment" },
        "fullPreviewBottomTitleAlignment": { "$ref": "#/$defs/titleAlignment" },
        "searchOverlayTitleAlignment": { "$ref": "#/$defs/titleAlignment" },
        "dangerOverlayTitleAlignment": { "$ref": "#/$defs/titleAlignment" },
        "helpOverlayTitleAlignment": { "$ref": "#/$defs/titleAlignment" },
        "selectedMarker": { "type": "string" },
        "selectedMarkedMarker": { "type": "string" },
        "markedMarker": { "type": "string" },
        "normalMarker": { "type": "string" },
        "scrollbarThumb": { "type": "string" },
        "scrollbarTrack": { "type": "string" },
        "statusSeparator": { "type": "string" }
      }
    },
    "styles": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "shell",
          "header",
          "list",
          "alternateRow",
          "selectedRow",
          "selectedMarkedRow",
          "markedRow",
          "rowSpacer",
          "emptyState",
          "preview",
          "previewGutter",
          "previewMeta",
          "previewSpacer",
          "fullPreview",
          "fullPreviewGutter",
          "fullPreviewMeta",
          "fullPreviewSpacer",
          "overlay",
          "searchOverlay",
          "dangerOverlay",
          "helpOverlay",
          "status",
          "scrollbar",
          "splitPaneGap"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/surfaceStyle"
      }
    },
    "labels": {
      "type": "object",
      "description": "String overrides for visible TUI copy and templates.",
      "propertyNames": {
        "enum": [
          "appTitle",
          "brand",
          "historyTitle",
          "previewTitle",
          "statusTitle",
          "headerSectionSeparator",
          "headerLabelSeparator",
          "headerLineTemplate",
          "filterLabel",
          "filterAll",
          "filterText",
          "filterImages",
          "filterFavorites",
          "filterToday",
          "queryLabel",
          "queryEmpty",
          "modeLabel",
          "singleSelection",
          "selectedPrefix",
          "selectedCountTemplate",
          "kindText",
          "kindImage",
          "rowPinnedLabel",
          "rowMetaTemplate",
          "rowPinnedSlotTemplate",
          "rowUnpinnedSlotTemplate",
          "entryIdPrefix",
          "listPositionTemplate",
          "emptyEntryPreview",
          "noHistoryTitle",
          "noHistoryHelp",
          "noMatchesTitle",
          "noMatchesHelp",
          "noEntryTitle",
          "noEntryHelp",
          "previewTypeGutter",
          "previewMimeGutter",
          "previewSizeGutter",
          "previewDimensionsGutter",
          "previewHashGutter",
          "previewBlobGutter",
          "previewImageEntry",
          "previewUnknownDimensions",
          "previewBlobMissing",
