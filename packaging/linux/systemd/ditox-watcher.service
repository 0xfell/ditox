[Unit]
Description=Ditox clipboard watcher daemon
Documentation=https://github.com/0xfell/ditox
# Wait until the graphical session is up so the clipboard backend is
# reachable (Wayland socket exported, etc.).
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# `--journal` routes ditox tracing events to the systemd journal once
# task 020/016 ship the journald layer (currently a stub that falls
# back to stderr; that's still captured by journald).
ExecStart=%h/.local/bin/ditox watch --journal
# If the daemon crashes, restart after 2 s. If it dies five times in
# 60 s, give up — likely a misconfiguration.
Restart=on-failure
RestartSec=2
StartLimitIntervalSec=60
StartLimitBurst=5
# Send SIGTERM on stop; the daemon's signal handler removes runtime
# files and exits cleanly.
KillSignal=SIGTERM
TimeoutStopSec=5

# Hardening (best-effort; some compositor backends need broader access).
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=graphical-session.target
